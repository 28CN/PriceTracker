# Supabase - browser side (publishable / anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Supabase - server side (secret / service role key)
# Needed by the crawler and by the site's write routes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Public application URL, without a trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth abuse protection and one-time account bootstrap
AUTH_RATE_LIMIT_PEPPER=replace-with-a-long-random-value
BOOTSTRAP_ACCOUNT_TOKEN=replace-with-a-separate-long-random-value
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Resend. Never commit or paste the real API key into chat.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=PriceTracker <alerts@your-domain.example>
RESEND_WEBHOOK_SECRET=whsec_xxx
EMAIL_WORKER_SECRET=replace-with-a-long-random-value

# GitHub, so the refresh button can start the crawl workflow
GITHUB_TOKEN=
GITHUB_OWNER=28CN
GITHUB_REPO=PriceTracker
GITHUB_WORKFLOW_ID=crawl-prices.yml
GITHUB_REF=main
