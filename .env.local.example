# Supabase - browser side (publishable / anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Supabase - server side (secret / service role key)
# Needed by the crawler and by the site's write routes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# GitHub, so the refresh button can start the crawl workflow
GITHUB_TOKEN=
GITHUB_OWNER=28CN
GITHUB_REPO=PriceTracker
GITHUB_WORKFLOW_ID=crawl-prices.yml
GITHUB_REF=main
