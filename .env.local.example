# Supabase - browser side (publishable / anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Supabase - server side (secret / service role key)
# Needed by the crawler and by the site's write routes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Direct Postgres connection for local SQL. The service role key cannot run
# CREATE/ALTER statements. Coding tools should use:
#   node scripts/db.mjs "select 1"
#   node scripts/db.mjs --file supabase/migrations/some.sql
# Copy the URI from Supabase → Project Settings → Database → Connection string.
# Use the database password, not the service role key. Prefer the direct
# connection. If that host is unreachable, use the Session pooler URI on port 5432.
# The runner refuses DROP DATABASE, DROP SCHEMA, DROP OWNED, ALTER DATABASE, and TRUNCATE.
SUPABASE_DB_URL=postgresql://postgres:REPLACE_WITH_DATABASE_PASSWORD@db.your-project.supabase.co:5432/postgres

# Public application URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth abuse protection and one-time account bootstrap
AUTH_RATE_LIMIT_PEPPER=replace-with-a-long-random-value
BOOTSTRAP_ACCOUNT_TOKEN=replace-with-a-separate-long-random-value
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Resend. Never commit or paste the real API key into chat.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=PriceTracker <alerts@your-domain.example>
RESEND_WEBHOOK_SECRET=whsec_xxx
EMAIL_WORKER_SECRET=replace-with-a-long-random-value

# GitHub, so the refresh button can start the crawl workflow.
# Without these, a refresh is still saved and runs on the next crawl.
# Fine-grained PAT, only this repo, Actions: read & write. See docs/GITHUB-TOKEN.md
GITHUB_TOKEN=
GITHUB_OWNER=28CN
GITHUB_REPO=PriceTracker
GITHUB_WORKFLOW_ID=crawl-prices.yml
GITHUB_REF=main

# Google Programmable Search. Limit the engine to the supported retailer
# domains. Search stays off until both values are set.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
